# Required for database-backed readiness and Alembic migrations.
# Example format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Required for document-grounded chat generation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

APP_NAME=FinDoc AI
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Generate a unique value with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false

# Private, local document storage and upload limit (20 MiB by default).
DOCUMENT_STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=20971520

# Local background ingestion (start Redis before the worker/API).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660

# Existing retrieval settings (optional).
FINDOC_CHUNK_SIZE=1000
FINDOC_CHUNK_OVERLAP=150
FINDOC_RETRIEVAL_CANDIDATES=12
FINDOC_FINAL_CHUNKS=4
FINDOC_RERANK_THRESHOLD=0.0
FINDOC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FINDOC_CONTEXT_CHAR_BUDGET=12000
CHAT_HISTORY_MESSAGES=8
